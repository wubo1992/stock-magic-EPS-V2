# 复制成 .env 后填入自己的 key（.env 已被 .gitignore 排除，不要提交）
# 说明：历史版本曾把密钥硬编码在源码里并推到公开仓库，那几个 key 必须全部轮换。

# Alpaca 数据 API（免费注册：https://alpaca.markets/）
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpha Vantage（EPS 数据源）
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub（EPS 数据源备用，免费层 60 次/分钟）
FINNHUB_API_KEY=your_finnhub_api_key_here

# Massive/Polygon（财务报表数据）
POLYGON_API_KEY=your_polygon_api_key_here

# Financial Modeling Prep（财务报表数据，免费层每天 250 次）
FMP_API_KEY=your_fmp_api_key_here
